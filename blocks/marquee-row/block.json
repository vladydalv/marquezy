{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "marquezy/marquee-row",
	"title": "Marquee row",
	"category": "design",
	"description": "One scrolling line of the Marquee block. Each paragraph is a phrase.",
	"parent": [
		"marquezy/marquee"
	],
	"textdomain": "marquezy",
	"attributes": {
		"direction": {
			"type": "string",
			"enum": [
				"left",
				"right"
			],
			"default": "left"
		},
		"separator": {
			"type": "string",
			"enum": [
				"none",
				"bar",
				"dot",
				"star",
				"diamond",
				"asterisk",
				"dash"
			],
			"default": "star"
		},
		"separatorColor": {
			"type": "string",
			"default": ""
		},
		"separatorSize": {
			"type": "number",
			"default": 16
		},
		"gap": {
			"type": "number",
			"default": 32
		},
		"shadow": {
			"type": "boolean",
			"default": false
		},
		"shadowColor": {
			"type": "string",
			"default": "#00000059"
		},
		"shadowX": {
			"type": "number",
			"default": 0
		},
		"shadowY": {
			"type": "number",
			"default": 8
		},
		"shadowBlur": {
			"type": "number",
			"default": 24
		},
		"shadowSpread": {
			"type": "number",
			"default": 0
		}
	},
	"usesContext": [
		"marquezy/pauseOnHover"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"padding": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "marquezy-editor"
}
